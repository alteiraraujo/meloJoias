# Configuracao local padrao: SQLite, sem servidor nem senha.
DB_ENGINE=sqlite
MELO_DEMO_MODE=0
MELO_DEBUG=0
MELO_PORT=8791

# Opcional para experimentar PostgreSQL 14+ no futuro:
# instale requirements-postgresql.txt e altere DB_ENGINE=postgresql.
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_NAME=melo_joias
# DB_USER=postgres
# DB_PASSWORD=''
# MELO_PG_BIN=C:/Program Files/PostgreSQL/17/bin
